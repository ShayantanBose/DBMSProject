{
  "manifest_version": 3,
  "name": "BrowseSync",
  "version": "1.0",
  "description": "A cross-browser extension with React",
  "action": {
    "default_popup": "index.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "tabs", "bookmarks"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
